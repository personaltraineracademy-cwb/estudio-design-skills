{
  "name": "site-cliente",
  "version": "0.1.0",
  "private": true,
  "description": "Página de captura / landing premium (Next.js 16, exportação estática). Template do estúdio: skills/criacao-de-sites.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs",
    "start:out": "node scripts/serve-out.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test lib/phone.test.ts",
    "size": "node scripts/size.mjs",
    "assets": "python scripts/build-assets.py",
    "logos": "python scripts/build-assets.py --so logos",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
